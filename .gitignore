# The Book's block (factory book init). Add the stack's own ignores below it.

# Claude Code local overrides (keep shared .claude/ config in git)
.claude/settings.local.json
# Agent worktrees — transient, never part of the product
.claude/worktrees/
# The guard hook's local log of refusals and warnings
.factory/
# Local environment files; the committed example stays
.env*
!.env.example
# Playwright MCP page snapshots — local, may show private documents
.playwright-mcp/
__pycache__/
# requirements/**/backup/ holds superseded tracker copies and must be tracked, whatever a stack's
# `Backup*/` rule says (Windows matches it case-insensitively).
!requirements/**/backup/
!requirements/**/backup/**
