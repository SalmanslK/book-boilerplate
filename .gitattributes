* text=auto
# A CRLF shebang breaks sh: hooks and scripts stay LF on every machine.
.githooks/*    text eol=lf
*.py           text eol=lf
*.sh           text eol=lf
# Generated files compared byte for byte stay LF.
docs/api/api-contracts.md text eol=lf
devtools/api/postman/*.json text eol=lf
*.ps1          text eol=crlf
*.pdf          binary
*.png          binary
*.xlsx         binary
